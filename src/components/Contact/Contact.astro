---
/**
 * * Contact section for the website
 */

import ContactForm from "@components/Forms/ContactForm.astro";
import siteData from "@config/siteData.json";
import { Image } from "astro:assets";

interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;

import contactPhoto from "@assets/images/photos/si-4.jpg";
---

<section
	id="contact"
	class="mx-auto max-w-md scroll-mt-10 px-4 py-8 md:max-w-6xl md:py-12"
	class:list={[className]}
>
<div class="grid gap-y-10 md:grid-cols-2">
    <div class="border-primary-300 pt-8 md:border-r md:pr-20 md:pl-12">
            <h2 class="h2 lg:text-6xl">Lets talk!</h2>
			<p class="description mt-6 text-lg">
				Its so much better to talk in person about the special requirements your special day
				deserves.
			</p>
			<p class="description mt-6 text-lg">
				Get in touch and we can get you some great music for your amazing day!
			</p>
			<p class="description mt-6 text-lg">
				Email me at
				<a
					class="underline underline-offset-2"
					href="mailto:{siteData.author.email}"
					title="Email {siteData.author.email}"
				>
					{siteData.author.email}</a
				>
				or call me on {siteData.author.tel}.
			</p>
		</div>
		<div class="md:pr-12 md:pl-20">
            <div class="mx-auto aspect-square overflow-hidden">
                <Image
                    src={contactPhoto}
                    alt="Si playing a festival"
                    width={450}
                    densities={[1.5, 2]}
                    class="h-full w-full object-cover"
                />
            </div>
			<!-- <ContactForm /> -->
		</div>
	</div>
</section>
