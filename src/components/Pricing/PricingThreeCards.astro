---
/**
 * * Package cards with three cards
 */

import Button from "@components/Button/Button.astro";
import { Image } from "astro:assets";

interface packageItem {
	name: string; // package name
	description: string; // package description
	featured?: boolean; // if true, will be highlighted or otherwise featured
	price: string;
	features: string[]; // list of features
	image: ImageMetadata; // imported image
}

import image3 from "@assets/images/photos/si-1.jpg";
import image1 from "@assets/images/photos/si-2.jpg";
import image2 from "@assets/images/photos/si-3.jpg";

// This is designed for 3 package items, but can be modified to support more
const packageData: packageItem[] = [
	{
		name: "Bronze",
		description: "The Perfect start to your wedding!",
		featured: false,
		price: "£450",
		features: [
			"Up to 20 minutes of music as the guests are seated",
			"Up to 3 songs whilst the register is being signed",
			"Up to 1 hour of live music for the drinks reception.",
			"You can pick songs for the set too!",
		],
		image: image1,
	},
	{
		name: "Silver",
		description:
			"This is the most popular choice to set a great atmosphere to start you wedding off! I can perform the drinks reception as chilled background or I can perform as your evening entertainment with a more lively set",
		featured: false,
		price: "£500",
		features: [
			"2 x 50 minute sets of live music for your drinks reception or evening party",
			"I can perform inside or outside",
			"Songs can be mellow, up beat or a mix, the choice can be yours",
			'I can "DJ" at the end of my set for up to an hour and a half (please enquire for price, this will be playlisted but we can choose the songs you want)',
			"I can also learn your first dance (please enquire for price)",
		],
		image: image2,
	},
	{
		name: "Gold",
		description:
			"I can be yours for the whole day, so you don't have to worry about multiple people disrupting your special day.",
		featured: true,
		price: "Enquire",
		features: [
			"1 hour of drinks reception chilled songs",
			"First Dance performed live",
			"2 x 50 minutes of upbeat and sing along anthems evening set (or one long set)",
			'Playlist "DJ" set to close the night (playlisted, but you can choose what you want!)',
			"Use of microphone and PA for speeches",
			"Music playlists (Spotify) played throughout the day",
			"Any other requests? let me know",
		],
		image: image3,
	},
];
---

<section id="packages" class="mx-auto max-w-7xl scroll-mt-10 px-4 py-8 md:py-12">
	<div class="mx-auto max-w-6xl text-center">
		<h2 class="h2 text-pretty">Packages</h2>
	</div>

	<!-- works for 3 pricing plans, adjust grid cols here to support more or less -->
	<div
		class="mx-auto grid w-full max-w-md gap-12 pt-8 sm:max-w-none sm:grid-cols-2 md:pt-12 lg:grid-cols-3"
	>
		{
			packageData.map((plan) => (
				<div
					class="flex w-full flex-col"
					class:list={[
						{
							"bg-primary-200": plan.featured === true,
						},
					]}
				>
					<div>
						<div class="aspect-[3/4] h-auto w-full overflow-hidden">
							<Image
								src={plan.image}
								alt={plan.name}
								width={450}
								densities={[1.5, 2]}
								class="h-full w-full object-cover"
							/>
						</div>
					</div>
					<div class="border-primary-200 flex h-full flex-col justify-between border-2 border-t-0 pt-10 pb-10">
						<div>
							<h3 class="h2 text-center">{plan.name}</h3>

							<p class="mt-4 flex flex-col gap-3 px-8 font-semibold lg:text-lg">
								{plan.description}
							</p>

							<ul class="mt-4 flex flex-col gap-3 px-8">
								{plan.features.map((feature) => (
									<li class="leading-snug lg:text-lg lg:leading-snug">{feature}</li>
								))}
							</ul>
						</div>
						<p class="h2 text-base-800 mt-6 flex justify-center text-center leading-none">
							{() => {
								if (!plan.featured) {
									return <span class="mt-2 mr-2 text-[1.5rem]">From</span>;
								}
							}}

							<span class="text-[2.4rem]"> {plan.price}</span>
						</p>
					</div>
				</div>
			))
		}
	</div>

	<div class="mt-12 flex justify-center">
		<Button href="/#contact" variant="outline" class="px-8">Get a quote</Button>
	</div>
</section>
